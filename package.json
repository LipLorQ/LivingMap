{
  "name": "living-map",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @living-map/desktop dev",
    "build": "pnpm --filter @living-map/desktop build",
    "mcp": "pnpm --filter @living-map/mcp start",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "db:generate": "pnpm --filter @living-map/persistence-sqlite db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "24.x",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
